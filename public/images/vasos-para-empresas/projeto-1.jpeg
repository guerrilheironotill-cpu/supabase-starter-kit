<style id="custom-animation-style-inline-css">

        .brx-animate-fadeInUpSmall {
            animation-name: fadeInUpSmall;
            animation-duration: 0.4s;
            animation-timing-function: ease-out;
            animation-fill-mode: both;
        }
        .brx-animate-fadeInDownSmall {
            animation-name: fadeInDownSmall;
            animation-duration: 0.4s;
            animation-timing-function: ease-out;
            animation-fill-mode: both;
        }
        .brx-animate-fadeInLeftSmall {
            animation-name: fadeInLeftSmall;
            animation-duration: 0.4s;
            animation-timing-function: ease-out;
            animation-fill-mode: both;
        }
        .brx-animate-fadeInRightSmall {
            animation-name: fadeInRightSmall;
            animation-duration: 0.4s;
            animation-timing-function: ease-out;
            animation-fill-mode: both;
        }

        @keyframes fadeInUpSmall {
            0% {
                opacity: 0;
                transform: translateY(10px); /* Pequeno movimento para cima */
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes fadeInDownSmall {
            0% {
                opacity: 0;
                transform: translateY(-10px); /* Pequeno movimento para baixo */
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes fadeInLeftSmall {
            0% {
                opacity: 0;
                transform: translateX(-10px); /* Pequeno movimento para a esquerda */
            }
            100% {
                opacity: 1;
                transform: translateX(0);
            }
        }
        @keyframes fadeInRightSmall {
            0% {
                opacity: 0;
                transform: translateX(10px); /* Pequeno movimento para a direita */
            }
            100% {
                opacity: 1;
                transform: translateX(0);
            }
        }
    
/*# sourceURL=custom-animation-style-inline-css */
</style>
