# Public environment selection. Values prefixed with VITE_ are bundled for the browser.
VITE_APP_ENV=local
VITE_SITE_URL=http://localhost:3000
VITE_GA_MEASUREMENT_ID=G-9M7JBYESBP
VITE_META_PIXEL_ID=1095272798860693

# Public Supabase client configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration. Never prefix the service role with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server runtime. Keep APP_ENV aligned with VITE_APP_ENV.
APP_ENV=local
PORT=3000
HOST=127.0.0.1
MAINTENANCE_MODE=false
# Token longo e secreto para revisar o site durante a manutenção via ?preview=TOKEN.
MAINTENANCE_BYPASS_TOKEN=

# Persistent VPS uploads (introduced in the image-storage phase).
UPLOAD_DIR=
UPLOAD_BASE_URL=/uploads
# Limite lógico exclusivo da Arteno (5 GiB por padrão).
ARTENO_STORAGE_LIMIT_BYTES=5368709120

# Optional server-side integrations.
GOOGLE_SERVICE_ACCOUNT_JSON=
